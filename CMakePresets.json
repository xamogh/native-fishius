{
  "version": 6,
  "configurePresets": [
    {
      "name": "desktop",
      "displayName": "Native desktop release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AQ_BUILD_APP": "ON",
        "AQ_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "domain",
      "displayName": "SDL-independent domain tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/domain",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AQ_BUILD_APP": "OFF",
        "AQ_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "sanitize",
      "inherits": "domain",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": {
        "AQ_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "jobs": 4
    },
    {
      "name": "domain",
      "configurePreset": "domain",
      "jobs": 4
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "domain",
      "configurePreset": "domain",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
